# Public environment variables must be prefixed with VITE_.
# Add values here only when a future client-side integration requires them.
VITE_APP_NAME=DaySpark
# Copy this file to .env and replace the values with your Firebase web app configuration.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:your-app-id
